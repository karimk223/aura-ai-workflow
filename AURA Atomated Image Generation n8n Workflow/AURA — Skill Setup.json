    {
      "parameters": {
        "jsCode": "const result=[]; const inputs=$input.all(); for(let i=0;i<inputs.length;i++){const item=inputs[i];const plan=$('Prepare Read-Only Bundle Reads').itemMatching(i).json;const files=[];for(const [field,file] of Object.entries(item.binary||{})){if(!field.startsWith('entry_'))continue;const path=[file.directory,file.fileName].filter(Boolean).join('/');const bytes=await this.helpers.getBinaryDataBuffer(i,field);if(bytes.length>1048576)throw new Error('Review unexpectedly large bundle entry manually: '+path);const isText=['.md','.json','.txt','.py','.js','.mjs','.ts','.sh','.yaml','.yml'].some(ext=>path.toLowerCase().endsWith(ext));files.push({path,bytes:bytes.length,...(isText?{text:bytes.toString('utf8')}: {})});} if(!files.some(f=>f.path.split('/').pop().toLowerCase()==='skill.md'))throw new Error('Missing SKILL.md for '+plan.role);result.push({json:{...plan,files},pairedItem:{item:i}});}return result;"
      },
