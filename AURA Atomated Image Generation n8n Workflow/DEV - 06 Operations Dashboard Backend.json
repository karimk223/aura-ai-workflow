    {
      "parameters": {
        "jsCode": "const sources = [\n  { node: 'List Received Pieces', key: 'received', area: 'raw' },\n  { node: 'List Processed Pieces', key: 'processed', area: 'raw' },\n  { node: 'List Approved Pieces', key: 'approved', area: 'raw' },\n  { node: 'List Rejected Pieces', key: 'rejected', area: 'raw' },\n  { node: 'List AIApproved Pieces', key: 'aiApproved', area: 'content' },\n  { node: 'List AIRejected Pieces', key: 'aiRejected', area: 'content' },\n  { node: 'List CreatorApproved Pieces', key: 'creatorApproved', area: 'content' },\n  { node: 'List CreatorRejected Pieces', key: 'creatorRejected', area: 'content' },\n  { node: 'List DesignerApproved Pieces', key: 'designerApproved', area: 'content' },\n  { node: 'List DesignerRejected Pieces', key: 'designerRejected', area: 'content' },\n];\n\nconst counts = Object.fromEntries(sources.map(source => [source.key, 0]));\nconst pieces = [];\n\nfor (const source of sources) {\n  const rows = $(source.node).all().map(item => item.json).filter(row => row.id && row.name);\n  counts[source.key] = rows.length;\n\n  for (const row of rows) {\n    pieces.push({\n      id: row.id,\n      name: row.name,\n      area: source.area,\n      stage: source.key,\n      updatedAt: row.modifiedTime ?? row.createdTime ?? null,\n      driveUrl: row.webViewLink ?? `https://drive.google.com/drive/folders/${row.id}`,\n    });\n  }\n}\n\npieces.sort((a, b) => a.name.localeCompare(b.name));\n\nreturn [{\n  json: {\n    generatedAt: new Date().toISOString(),\n    counts,\n    pieces,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
