    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const transferUrl = item.json.transferUrl || '';\n\n  const match = transferUrl.match(\n    /^https:\\/\\/(?:www\\.)?wetransfer\\.com\\/downloads\\/([A-Za-z0-9_-]+)\\/([A-Za-z0-9_-]+)\\/([A-Za-z0-9_-]+)$/i\n  );\n\n  if (!match) {\n    return {\n      json: {\n        ...item.json,\n        downloadRequestReady: false,\n        downloadError: 'Unsupported WeTransfer URL format',\n      },\n    };\n  }\n\n  const [, transferId, recipientId, securityHash] = match;\n\n  return {\n    json: {\n      ...item.json,\n      transferId,\n      recipientId,\n      securityHash,\n      downloadRequestReady: true,\n    },\n  };\n});"
      },
