    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst preparedItems = $('Prepare WeTransfer Download').all();\n\nreturn responses.map((item, index) => {\n  const prepared = preparedItems[index]?.json || {};\n  const directLink = String(item.json.direct_link || '');\n\n  const directLinkValid =\n    /^https:\\/\\/download\\.wetransfer\\.com\\/[^\\s]+$/i.test(directLink);\n\n  const pathWithoutQuery = directLink.split('?')[0];\n  const encodedName =\n    pathWithoutQuery.split('/').pop() ||\n    'wetransfer-download';\n\n  let decodedName;\n\n  try {\n    decodedName = decodeURIComponent(encodedName);\n  } catch {\n    decodedName = encodedName;\n  }\n\n  const fileName = decodedName\n    .replace(/[\\/\\\\\\0\\r\\n]/g, '_')\n    .replace(/^\\.+/, '')\n    .slice(0, 180) || 'wetransfer-download';\n\n  return {\n    json: {\n      ...prepared,\n      directDownloadUrl: directLinkValid\n        ? directLink\n        : null,\n      directLinkValid,\n      fileName,\n    },\n  };\n});"
      },
