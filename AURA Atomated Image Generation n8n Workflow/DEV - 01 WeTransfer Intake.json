        "gmailOAuth2": {
          "id": "ygKVbEMpfgjQnyTL",
          "name": "Gmail - Aura Intake"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const email = item.json;\n\n  const content = [\n    email.text,\n    email.html,\n    email.textAsHtml,\n  ]\n    .filter(value => typeof value === 'string')\n    .join('\\n')\n    .replace(/&amp;/gi, '&');\n\n  // Extract only an approved WeTransfer download URL.\n  // Tracking parameters are intentionally removed.\n  const fullLinkPattern =\n    /https:\\/\\/(?:www\\.)?wetransfer\\.com\\/downloads\\/[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+/i;\n\n  const shortLinkPattern =\n    /https:\\/\\/we\\.tl\\/t-[A-Za-z0-9_-]+/i;\n\n  const fullMatch = content.match(fullLinkPattern);\n  const shortMatch = content.match(shortLinkPattern);\n\n  const transferUrl =\n    fullMatch?.[0] ||\n    shortMatch?.[0] ||\n    null;\n\n  const sender =\n    email.from?.value?.[0]?.address || '';\n\n  const uploadedBy =\n    email.replyTo?.value?.[0]?.address || '';\n\n  const subject = email.subject || '';\n\n  const transferTitle =\n    subject.match(/sent you (.+?) via WeTransfer$/i)?.[1]?.trim() || '';\n\n  const authenticationResults = [\n    email.headers?.['authentication-results'] || '',\n    email.headers?.['arc-authentication-results'] || '',\n  ].join('\\n');\n\n  const senderValid =\n    sender.toLowerCase() === 'noreply@wetransfer.com';\n\n  const dkimValid =\n    /dkim=pass[^;\\r\\n]*header\\.i=@wetransfer\\.com/i\n      .test(authenticationResults);\n\n  const dmarcValid =\n    /dmarc=pass[^;\\r\\n]*header\\.from=wetransfer\\.com/i\n      .test(authenticationResults);\n\n  return {\n    json: {\n      gmailMessageId: email.id,\n      gmailThreadId: email.threadId,\n      notificationSender: sender,\n      uploadedBy,\n      subject,\n      transferTitle,\n      receivedAt: email.date || '',\n      transferUrl,\n      transferUrlValid: Boolean(transferUrl),\n      senderValid,\n      dkimValid,\n      dmarcValid,\n      emailAuthenticated:\n        senderValid && dkimValid && dmarcValid,\n    },\n  };\n});"
      },
