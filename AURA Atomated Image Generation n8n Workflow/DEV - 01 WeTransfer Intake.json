      "name": "Get Full WeTransfer Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        -3904,
        768
      ],
      "webhookId": "cfeac2b4-a46e-4b67-b984-255a58da9e78",
