      "parameters": {
        "jsCode": "const piece = $('Prepare Designer Review Piece').first().json;\n\nconst images = $input.all()\n  .map(item => ({\n    id: item.json.id,\n    name: item.json.name,\n    url: `https://drive.google.com/thumbnail?id=${item.json.id}&sz=w1600`,\n  }))\n  .sort((a, b) => a.name.localeCompare(b.name));\n\nreturn [{\n  json: {\n    pieceFolderId: piece.pieceFolderId,\n    pieceName: piece.pieceName,\n    imageCount: images.length,\n    images,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
