        "jsCode": "const request = $(\"Prepare Designer Decision\").first().json;\n\nconst folderExists = $input\n  .all()\n  .some(item => item.json.id === request.pieceFolderId);\n\nreturn [{\n  json: {\n    pieceFolderId: request.pieceFolderId,\n    decision: request.decision,\n    folderExists\n  }\n}];"
      },
